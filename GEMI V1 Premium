local main = window:Section("Instant Summit")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local Event = ReplicatedStorage.Remotes.ResetEvent

local Positions = {
    CFrame.new(-5897.765, 2708.867, -763.761),
    CFrame.new(-6684.920, 3067.994, -802.448)
}

local loopConn
local index = 1

local function getHRP()
    local char = Player.Character or Player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function teleportOnce()
    getHRP().CFrame = Positions[index]
    Event:FireServer()
    index += 1
    if index > #Positions then
        index = 1
    end
end

local function stopLoop()
    if loopConn then
        loopConn:Disconnect()
        loopConn = nil
    end
end

main:Dropdown(
    "Mode",
    {"Once", "Loop", "Stop Loop"},
    "Once",
    function(selected)
        if selected == "Once" then
            stopLoop()
            teleportOnce()

        elseif selected == "Loop" then
            stopLoop()
            loopConn = RunService.Heartbeat:Connect(function()
                teleportOnce()
            end)

        elseif selected == "Stop Loop" then
            stopLoop()
        end
    end
)

