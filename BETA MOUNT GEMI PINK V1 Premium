local main = window:Section("Instant Summit")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

local TargetCF = CFrame.new(-6681.659, 3065.497, -785.977)

local Event = game:GetService("ReplicatedStorage")
    .CheckpointRemotes.ResetCheckpoint

local loopConn

local function getHRP()
    local char = Player.Character or Player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function teleport()
    getHRP().CFrame = TargetCF
    Event:FireServer()
end

local function stopLoop()
    if loopConn then
        loopConn:Disconnect()
        loopConn = nil
    end
end

main:Dropdown(
    "Mode",
    {"Once", "Loop", "Stop Loop"},
    "Once",
    function(selected)
        if selected == "Once" then
            stopLoop()
            teleport()

        elseif selected == "Loop" then
            stopLoop()
            loopConn = RunService.Heartbeat:Connect(function()
                teleport()
            end)

        elseif selected == "Stop Loop" then
            stopLoop()
        end
    end
)

