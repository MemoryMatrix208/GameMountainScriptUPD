local main = window:Section("Instant Summit")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

local Targets = {
    Vector3.new(-4772.897, 1434.615, 14055.265),
    Vector3.new(-3422.871, 1833.047, 14890.703)
}

local Event = game:GetService("ReplicatedStorage")
    .KeongReplic.RemoteEvents.CheckpointReset

local Looping = false
local TOLERANCE = 0.5

local function getHRP()
    local char = Player.Character or Player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function waitUntilArrived(hrp, pos)
    repeat
        RunService.Heartbeat:Wait()
    until (hrp.Position - pos).Magnitude <= TOLERANCE
end

local function teleportSequence()
    local hrp = getHRP()

    for _, pos in ipairs(Targets) do
        if not Looping then return end

        hrp.CFrame = CFrame.new(pos)
        waitUntilArrived(hrp, pos)
        task.wait(0.6)
    end

    task.wait(0.1)
    Event:FireServer()
end

local function stopLoop()
    Looping = false
end

main:Dropdown(
    "Mode",
    {"Once", "Loop", "Stop Loop"},
    "Once",
    function(selected)
        if selected == "Once" then
            stopLoop()
            Looping = true
            teleportSequence()
            Looping = false

        elseif selected == "Loop" then
            stopLoop()
            Looping = true
            task.spawn(function()
                while Looping do
                    teleportSequence()
                    task.wait(1.5)
                end
            end)

        elseif selected == "Stop Loop" then
            stopLoop()
        end
    end
)

