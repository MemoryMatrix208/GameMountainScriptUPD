local SpeedMap = {
    ["Ultra Slow"] = 9,
    ["Glacial"] = 8,
    ["Snail Pace"] = 7,
    ["Very Slow"] = 6,
    ["Slow"] = 5,
    ["Normal"] = 4,
    ["Moderate"] = 3,
    ["Steady"] = 2.5,
    ["Brisk"] = 2,
    ["Fast"] = 1.6,
    ["Quick"] = 1.3,
    ["Very Fast"] = 1,
    ["Super Fast"] = 0.8,
    ["Ultra Fast"] = 0.6,
    ["Hyper Speed"] = 0.4,
    ["Lightning Fast"] = 0.2,
    ["Warp Speed"] = 0.1,
    ["Instant"] = 0
}

local SpeedValues = {}
for k in pairs(SpeedMap) do
    table.insert(SpeedValues, k)
end
table.sort(SpeedValues)

local function StopAuto()
    AutoLoop = false
end

local function StartAuto()
    if AutoLoop then return end
    AutoLoop = true

    task.spawn(function()
        while AutoLoop do
            local char = player.Character or player.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart")

            for _, pos in ipairs(SpawnRoutes.DROP) do
                if not AutoLoop then return end
                hrp.CFrame = CFrame.new(pos)
                task.wait(CurrentDelay)
            end

            local resetEvent = ReplicatedStorage:FindFirstChild("ResetCPEvent")
            if resetEvent then
                resetEvent:FireServer()
            end

            player.CharacterAdded:Wait()
            task.wait(1.5)
        end
    end)
end

main:Dropdown(
    "Teleport Speed",
    SpeedValues,
    "Normal",
    function(value)
        SelectedSpeed = value
        CurrentDelay = SpeedMap[value] or 4
    end
)

main:Dropdown(
    "Control",
    {"Start", "Stop"},
    "Start",
    function(value)
        if value == "Start" then
            StartAuto()
        else
            StopAuto()
        end
    end
)

