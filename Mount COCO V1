    Default = 1,
    Multi = false,
    Text = "Mode",
    Callback = function(Value)
        if Value == "Once" then
            stopLoop()
            Looping = true
            teleportSequence()
            Looping = false

        elseif Value == "Loop" then
            stopLoop()
            Looping = true
            task.spawn(function()
                while Looping do
                    teleportSequence()
                    task.wait(1.5)
                end
            end)

        elseif Value == "Stop Loop" then
            stopLoop()
        end
    end
})

