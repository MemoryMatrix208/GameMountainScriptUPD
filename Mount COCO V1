}

local Event = game:GetService("ReplicatedStorage")
    .KeongReplic.RemoteEvents.CheckpointReset

local Looping = false
local TOLERANCE = 0.5

local function getHRP()
    local char = Player.Character or Player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function waitUntilArrived(hrp, pos)
    repeat
        RunService.Heartbeat:Wait()
    until (hrp.Position - pos).Magnitude <= TOLERANCE
end

local function teleportSequence()
    local hrp = getHRP()

    for _, pos in ipairs(Targets) do
        if not Looping then return end

        hrp.CFrame = CFrame.new(pos)
        waitUntilArrived(hrp, pos)

        task.wait(0.6) -- pause manusia
    end

    task.wait(0.1) -- FINAL WAIT
    Event:FireServer()
end

local function stopLoop()
    Looping = false
end

Group:AddDropdown("ModeDropdown", {
